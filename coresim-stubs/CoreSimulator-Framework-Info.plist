<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist for the CoreSimulator.framework bundle we assemble around the
  patched binary.

  Boot reaches -[SimDeviceIOServer loadAllBundlesWithError:], which calls
  [NSBundle bundleWithIdentifier:@"com.apple.CoreSimulator"] to locate its own
  framework and load the device-IO plugins from it. A bare dylib belongs to no
  bundle, so that lookup threw "Failed to find bundle with identifier". This
  file is what makes it resolve.

  Kept as a checked-in file rather than a heredoc in the workflow: heredoc
  bodies sit at column 0, which terminates the YAML `run: |` literal block and
  silently corrupts the whole workflow (it has already cost two builds).

  Version is 993.7 to match +[SimServiceContext serviceVersionString], since
  CoreSimulator compares its framework version against the service version.
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.apple.CoreSimulator</string>
	<key>CFBundleExecutable</key>
	<string>CoreSimulator</string>
	<key>CFBundleName</key>
	<string>CoreSimulator</string>
	<key>CFBundlePackageType</key>
	<string>FMWK</string>
	<key>CFBundleShortVersionString</key>
	<string>993.7</string>
	<key>CFBundleVersion</key>
	<string>993.7</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>MinimumOSVersion</key>
	<string>15.0</string>
	<!--
	  installd rejected the first version of this file outright:

	    "Info.plist from bundle at path .../CoreSimulator.framework had none
	     of the keys that we expect ... keyCount=8"

	  An embedded framework needs the platform/build keys below, not just the
	  generic CFBundle* set. CFBundleSupportedPlatforms is the important one --
	  without it installd cannot tell this is an iOS framework and refuses the
	  whole app. The DT* keys are what Xcode stamps into any real framework;
	  they're cheap to include and make this look like the genuine article to
	  the installer. Values match the iOS 18.1 SDK the rest of the app is
	  built against.
	-->
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>DTPlatformName</key>
	<string>iphoneos</string>
	<key>DTPlatformVersion</key>
	<string>18.1</string>
	<key>DTSDKName</key>
	<string>iphoneos18.1</string>
	<key>DTCompiler</key>
	<string>com.apple.compilers.llvm.clang.1_0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
</dict>
</plist>
